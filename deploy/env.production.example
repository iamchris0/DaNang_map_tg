# Production settings. Copy to .env.production on the server (never commit it):
#   cp deploy/env.production.example .env.production
# Generate secrets with:  openssl rand -base64 48

# --- Domain / HTTPS ---------------------------------------------------------------
# Your domain (Caddy obtains a certificate automatically; DNS A record must point here).
SITE_ADDRESS=apartments.example.com
PUBLIC_APP_URL=https://apartments.example.com

# --- Secrets ------------------------------------------------------------------------
SESSION_SECRET=
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Telegram ------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Mini App short name from @BotFather /newapp (enables t.me/<bot>/<name>?startapp= links).
TELEGRAM_MINI_APP_SHORT_NAME=app
TELEGRAM_CHANNEL_ID=
# Language of channel posts: en, ru or vi.
TELEGRAM_POST_LANGUAGE=en
# Full administrators (see and manage every listing). Landlords sign up in the bot.
ADMIN_TELEGRAM_USER_IDS=
ADMIN_CONTACT_TELEGRAM=

# --- Cloudflare tunnel (docker-compose.tunnel.yml) ---------------------------------------
# Empty: quick tunnel with a random address. Named tunnel: CLOUDFLARE_TUNNEL_ARGS=run + token.
CLOUDFLARE_TUNNEL_ARGS=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Storage / map / geocoding -------------------------------------------------------
S3_BUCKET=danang-apartments
# Photos are served by Caddy under /media. Point at a CDN or external bucket URL instead if
# you use hosted S3 (then also set S3_ENDPOINT_URL in docker-compose.prod.yml).
S3_PUBLIC_BASE_URL=/media
VITE_MAP_STYLE_URL=
GEOCODING_USER_AGENT=DaNangApartments/1.0 (+https://apartments.example.com)
LOG_LEVEL=INFO
