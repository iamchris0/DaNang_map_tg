# Copy to .env and adjust. Never commit .env. Values below are local-development defaults.

# --- General -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (Docker Compose builds DATABASE_URL from these) ----------------
POSTGRES_USER=danang
POSTGRES_PASSWORD=danang
POSTGRES_DB=danang
# host port; 5433 avoids clashing with a local Postgres
DB_PORT=5433
# Only needed when running the backend outside Docker:
DATABASE_URL=postgresql+asyncpg://danang:danang@localhost:5433/danang

# --- HTTP ---------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Comma-separated origins allowed to call the API cross-origin. Leave empty when the
# frontend and API share an origin (the Vite dev proxy / production reverse proxy).
CORS_ORIGINS=
# Public HTTPS URL where the Mini App is served (used in links and the bot menu button).
PUBLIC_APP_URL=http://localhost:5173
# Extra hostnames Vite accepts (e.g. your HTTPS tunnel host), comma-separated.
VITE_ALLOWED_HOSTS=

# --- Auth ---------------------------------------------------------------------
# Random string, >= 32 chars in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_MINUTES=1440
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Local-only login bypass for browser development. Rejected at startup in production.
DEV_AUTH_ENABLED=false
# Comma-separated numeric Telegram user IDs with admin rights (e.g. 123456789,987654321).
ADMIN_TELEGRAM_USER_IDS=
# Rate limits ("<count>/<second|minute|hour>"): login attempts per IP, admin writes per admin.
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_ADMIN_WRITE=120/minute

# --- Listings -------------------------------------------------------------------
# Listings must be located inside this box: min_lng,min_lat,max_lng,max_lat (Da Nang + Hoa Vang).
SERVICE_AREA_BBOX=107.80,15.85,108.40,16.25

# --- Telegram -----------------------------------------------------------------
# from @BotFather; server-side only
TELEGRAM_BOT_TOKEN=
# without @
TELEGRAM_BOT_USERNAME=
# short name set in @BotFather /newapp (for t.me deep links)
TELEGRAM_MINI_APP_SHORT_NAME=
# numeric (-100…) or @channelusername; bot must be channel admin
TELEGRAM_CHANNEL_ID=
# en | ru
TELEGRAM_POST_LANGUAGE=en
# channel administrator's Telegram username, without @
ADMIN_CONTACT_TELEGRAM=

# --- S3-compatible object storage ---------------------------------------------
# omit for AWS S3
S3_ENDPOINT_URL=http://localhost:9000
# public URL prefix for image delivery (CDN or bucket URL)
S3_PUBLIC_BASE_URL=
S3_REGION=us-east-1
S3_BUCKET=danang-apartments
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
# development only; must be false in production
S3_AUTO_CREATE_BUCKET=true
S3_PORT=9000
S3_CONSOLE_PORT=9001
